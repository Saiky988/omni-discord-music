# ============================================================================
# OMNI DISCORD MUSIC — ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and fill in your actual Discord credentials.
# Never commit your .env file or real credentials to version control.
# ============================================================================

# [REQUIRED] Discord Bot Token from the Discord Developer Portal
DISCORD_TOKEN=your_discord_bot_token_here

# [REQUIRED] Discord Application / Client ID (15-22 digit Snowflake)
DISCORD_CLIENT_ID=000000000000000000

# [OPTIONAL] Development Guild (Server) ID for instant guild-scoped slash command deployment.
# Leave empty in production to register global slash commands.
DISCORD_GUILD_ID=

# [OPTIONAL] Text command prefix (1-5 non-whitespace characters, default: !)
PREFIX=!

# [OPTIONAL] Default per-guild playback volume percentage (0..MAX_VOLUME, default: 80)
DEFAULT_VOLUME=80

# [OPTIONAL] Maximum allowed playback volume percentage (1..500, default: 200)
MAX_VOLUME=200

# [OPTIONAL] Milliseconds of inactivity before leaving a voice channel (default: 180000 = 3 minutes)
IDLE_TIMEOUT_MS=180000

# [OPTIONAL] Maximum number of upcoming tracks permitted per guild queue (default: 500)
MAX_QUEUE_SIZE=500

# [OPTIONAL] Maximum number of tracks imported from a single playlist or album (default: 100)
MAX_PLAYLIST_TRACKS=100

# [OPTIONAL] Maximum duration in seconds for a single non-live track (default: 14400 = 4 hours)
MAX_TRACK_DURATION_SECONDS=14400

# [OPTIONAL] Structured logger severity level: debug | info | warn | error | silent (default: info)
LOG_LEVEL=info

# [OPTIONAL] System path or binary name for yt-dlp (default: yt-dlp)
YTDLP_PATH=yt-dlp

# [OPTIONAL] System path or binary name for ffmpeg (default: ffmpeg)
FFMPEG_PATH=ffmpeg

# [OPTIONAL] Metadata resolution timeout in milliseconds (default: 20000)
RESOLVE_TIMEOUT_MS=20000

# [OPTIONAL] Stream process startup timeout in milliseconds (default: 15000)
STREAM_SPAWN_TIMEOUT_MS=15000

# [OPTIONAL] Grace period in milliseconds before SIGTERM escalates to SIGKILL (default: 5000)
PROCESS_KILL_TIMEOUT_MS=5000

# [OPTIONAL] Timeout in milliseconds waiting for VoiceConnection Ready state (default: 20000)
VOICE_READY_TIMEOUT_MS=20000

# [OPTIONAL] Maximum automatic voice connection recovery attempts (default: 3)
VOICE_RECONNECT_ATTEMPTS=3

# [OPTIONAL] Maximum consecutive track extraction failures before halting auto-advancement (default: 3)
MAX_CONSECUTIVE_FAILURES=3

# [OPTIONAL] Concurrent track resolution workers for Spotify/Apple Music playlists (default: 3)
PLAYLIST_CONCURRENCY=3

# [OPTIONAL] Metadata cache TTL in milliseconds (default: 300000 = 5 minutes)
METADATA_CACHE_TTL_MS=300000

# [OPTIONAL] Maximum entries stored in the bounded metadata cache (default: 250)
METADATA_CACHE_MAX_ENTRIES=250

# [OPTIONAL] Permit non-HTTPS (http://) direct media links (default: false)
ALLOW_HTTP_MEDIA=false
